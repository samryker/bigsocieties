APP_NAME="Rentals API"
ENVIRONMENT=production
DEBUG=false

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:25060/DATABASE?ssl=require

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

BACKEND_CORS_ORIGINS=["https://your-flutter-web-app.vercel.app","https://yourdomain.com"]
